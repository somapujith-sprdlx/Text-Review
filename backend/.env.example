# Single key. For multiple shared keys (so one key's rate limit doesn't
# become everyone's), set GROQ_API_KEYS instead, comma-separated — it takes
# priority over GROQ_API_KEY when both are set.
GROQ_API_KEY=your-groq-api-key-here
# GROQ_API_KEYS=key-one,key-two,key-three
GROQ_MODEL=openai/gpt-oss-120b
ALLOWED_ORIGIN=chrome-extension://your-extension-id
PORT=8787
# Neon Postgres connection string, for onboarding/rating-gate device state
# (backend/src/services/db). Omit it and those features fail open (nothing
# blocked, onboarding always shows) instead of crashing.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
