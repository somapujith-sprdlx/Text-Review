# Copy to .dev.vars for `npm run dev:worker` (wrangler dev). Gitignored.
GROQ_API_KEY=your-groq-api-key-here
# Multiple shared keys instead, comma-separated — takes priority over
# GROQ_API_KEY when both are set. In production set this with
# `npx wrangler secret put GROQ_API_KEYS`.
# GROQ_API_KEYS=key-one,key-two,key-three

# Neon Postgres connection string, for onboarding/rating-gate device state.
# Omit it and those features fail open rather than crash. In production set
# this with `npx wrangler secret put DATABASE_URL`.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
