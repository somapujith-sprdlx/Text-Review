{
  "manifest_version": 3,
  "name": "Text Quality Enhancer",
  "version": "0.1.0",
  "description": "Improve selected text on any webpage using AI-powered writing styles.",
  "permissions": ["sidePanel", "storage", "activeTab", "scripting", "contextMenus"],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"]
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
